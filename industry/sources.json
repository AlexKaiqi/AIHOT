{
  "$comment": "示范信源：首次启动时导入（scripts/seed.ts），已存在的不会被覆盖。之后在后台“信源”里增删改。字段说明见 docs/customize.md。Anthropic/DeepSeek 没有 RSS，用 web_list 解析；每次改版后先在后台“试抓”确认。",
  "sources": [
    {
      "id": "rss-openai-news",
      "name": "OpenAI News",
      "kind": "rss",
      "config": {
        "feedUrl": "https://openai.com/news/rss.xml",
        "_aihot": {
          "initialBackfillLimit": 8
        }
      },
      "tier": "T1",
      "first_party": true,
      "owner_entity_id": "openai",
      "participation_mode": "editorial",
      "interval_minutes": 120,
      "tags": [
        "官方"
      ],
      "site_fulltext": false,
      "syndicate_fulltext": false
    },
    {
      "id": "web-anthropic-engineering",
      "name": "Anthropic Engineering",
      "kind": "web_list",
      "config": {
        "url": "https://www.anthropic.com/engineering",
        "itemSelector": "a:has(h2), a:has(h3)",
        "linkSelector": "a",
        "titleSelector": "h2, h3",
        "publishedAtSelector": "time",
        "allowUrlPrefixes": [
          "https://www.anthropic.com/engineering"
        ],
        "detail": {
          "maxFetches": 20
        },
        "_aihot": {
          "initialBackfillLimit": 8
        }
      },
      "tier": "T1",
      "first_party": true,
      "owner_entity_id": "anthropic",
      "participation_mode": "editorial",
      "interval_minutes": 120,
      "tags": [
        "官方",
        "技术文章"
      ],
      "site_fulltext": false,
      "syndicate_fulltext": false
    },
